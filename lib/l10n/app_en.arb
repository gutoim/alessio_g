{
  "@@locale": "en",
  "appTitle": "DummyJSON Shop",
  "@appTitle": {
    "description": "Application title shown in the task switcher and on the login screen."
  },
  "loginSubtitle": "Sign in to continue",
  "@loginSubtitle": {
    "description": "Text under the app title on the login screen."
  },
  "loginUsernameLabel": "Username",
  "@loginUsernameLabel": {
    "description": "Label of the username field on the login screen."
  },
  "loginPasswordLabel": "Password",
  "@loginPasswordLabel": {
    "description": "Label of the password field on the login screen."
  },
  "loginShowPassword": "Show password",
  "@loginShowPassword": {
    "description": "Tooltip of the button that reveals the password."
  },
  "loginHidePassword": "Hide password",
  "@loginHidePassword": {
    "description": "Tooltip of the button that hides the password again."
  },
  "loginUsernameRequired": "Enter your username",
  "@loginUsernameRequired": {
    "description": "Validation error when the username field is empty."
  },
  "loginPasswordRequired": "Enter your password",
  "@loginPasswordRequired": {
    "description": "Validation error when the password field is empty."
  },
  "loginButton": "Log in",
  "@loginButton": {
    "description": "Primary button on the login screen that submits the credentials."
  },
  "loginInProgress": "Logging in",
  "@loginInProgress": {
    "description": "Screen reader label of the login button while the request is running."
  },
  "logoutTooltip": "Log out",
  "@logoutTooltip": {
    "description": "Tooltip of the log out button in the app bar."
  },
  "productsTitle": "Products",
  "@productsTitle": {
    "description": "App bar title of the product list screen."
  },
  "productsEmptyTitle": "No products yet",
  "@productsEmptyTitle": {
    "description": "Title of the empty state of the product list."
  },
  "productsEmptyMessage": "Pull down to check again.",
  "@productsEmptyMessage": {
    "description": "Hint under the empty state title of the product list."
  },
  "productsEndOfList": "{count, plural, =1{That's the only product} other{That's all {count} products}}",
  "@productsEndOfList": {
    "description": "Shown under the last product once the whole catalog is loaded.",
    "placeholders": {
      "count": {"type": "int", "example": "194"}
    }
  },
  "retryButton": "Try again",
  "@retryButton": {
    "description": "Button that repeats a request that failed."
  },
  "priceWithDiscount": "{price}, reduced from {originalPrice}",
  "@priceWithDiscount": {
    "description": "Screen reader text for a discounted price.",
    "placeholders": {
      "price": {"type": "String", "example": "$8.94"},
      "originalPrice": {"type": "String", "example": "$9.99"}
    }
  },
  "ratingLabel": "Rated {rating} out of 5",
  "@ratingLabel": {
    "description": "Screen reader text for a product rating.",
    "placeholders": {
      "rating": {"type": "String", "example": "4.5"}
    }
  },
  "productDetailTitle": "Product details",
  "@productDetailTitle": {
    "description": "App bar title of the product detail screen."
  },
  "failureInvalidCredentials": "Wrong username or password.",
  "@failureInvalidCredentials": {
    "description": "Shown when the login is rejected."
  },
  "failureNetwork": "No internet connection. Check your connection and try again.",
  "@failureNetwork": {
    "description": "Shown when the server can't be reached or the request timed out."
  },
  "failureUnauthorized": "Your session has expired. Please log in again.",
  "@failureUnauthorized": {
    "description": "Shown when the access token is missing, invalid or expired."
  },
  "failureNotFound": "We couldn't find what you were looking for.",
  "@failureNotFound": {
    "description": "Shown when the requested item does not exist."
  },
  "failureServer": "Something went wrong on our side. Please try again.",
  "@failureServer": {
    "description": "Shown for unexpected HTTP errors from the server."
  },
  "failureUnknown": "Something went wrong. Please try again.",
  "@failureUnknown": {
    "description": "Shown for any other unexpected error."
  }
}
